# Copy to .env.development.local (local) or set in Vercel per environment (Preview / Production).
# Only VITE_-prefixed variables reach the browser bundle. Only the Supabase URL and the
# public anon / publishable key may ever be VITE_-prefixed.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Test-only (.env.test.local and GitHub Actions secrets), dev project only. Never prefix with
# VITE_, never commit a real value, never use in src/ (ADR 0012).
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=replace-with-dev-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-dev-secret-key-tests-only

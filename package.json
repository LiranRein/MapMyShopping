{
  "name": "mapmyshopping",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/scan-bundle-secrets.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:secrets": "node scripts/scan-bundle-secrets.mjs dist",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:integration": "vitest run -c vitest.integration.config.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-preact": "^1.63.0",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
